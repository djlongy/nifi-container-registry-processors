{
  "process_group": {
    "name": "ImageTransferLowSide"
  },
  "objects": [
    {
      "type": "processor",
      "name": "ReceiveWebhook",
      "processor_type": "org.apache.nifi.processors.standard.ListenHTTP",
      "properties": {
        "Base Path": "image-transfer-webhook",
        "Listening Port": "9617",
        "HTTP Headers for Attributes": "(?i)(X-.*|Filename|Content-Type)",
        "Return Code": "202",
        "Maximum Thread Pool Size": "16"
      },
      "auto_terminated": [],
      "bundle": {
        "group": "org.apache.nifi",
        "artifact": "nifi-standard-nar",
        "version": "2.12.0"
      }
    },
    {
      "type": "processor",
      "name": "PlanTransfer",
      "processor_type": "PlanRegistryTransfer",
      "properties": {
        "Source Registry URL": "#{gitlab.container.url}",
        "Source Registry Username": "#{gitlab.container.username}",
        "Source Registry Password": "#{gitlab.container.token}",
        "Allowed Repositories": "#{gitlab.container.allowed.repositories}",
        "Platform Selection": "#{gitlab.container.platforms}",
        "Request Timeout": "120"
      },
      "auto_terminated": [
        "original"
      ],
      "bundle": {
        "group": "org.apache.nifi",
        "artifact": "python-extensions",
        "version": "1.5.3"
      }
    },
    {
      "type": "processor",
      "name": "SplitJobs",
      "processor_type": "org.apache.nifi.processors.standard.SplitJson",
      "properties": {
        "JsonPath Expression": "$.jobs"
      },
      "auto_terminated": [
        "original"
      ],
      "bundle": {
        "group": "org.apache.nifi",
        "artifact": "nifi-standard-nar",
        "version": "2.12.0"
      }
    },
    {
      "type": "processor",
      "name": "RouteTransfer",
      "processor_type": "RouteRegistryTransfer",
      "properties": {
        "Transfer Side": "Low",
        "Registry URL": "#{gitlab.container.url}",
        "Registry Username": "#{gitlab.container.username}",
        "Registry Password": "#{gitlab.container.token}"
      },
      "auto_terminated": [
        "original",
        "stale",
        "waiting"
      ],
      "bundle": {
        "group": "org.apache.nifi",
        "artifact": "python-extensions",
        "version": "1.5.3"
      }
    },
    {
      "type": "processor",
      "name": "FetchBlob",
      "processor_type": "org.apache.nifi.processors.standard.InvokeHTTP",
      "properties": {
        "HTTP Method": "GET",
        "HTTP URL": "${registry.http.url}",
        "Authorization": "${registry.auth.header}",
        "Connection Timeout": "30 secs",
        "Socket Read Timeout": "10 mins",
        "Socket Write Timeout": "10 mins"
      },
      "auto_terminated": [
        "Original"
      ],
      "bundle": {
        "group": "org.apache.nifi",
        "artifact": "nifi-standard-nar",
        "version": "2.12.0"
      }
    },
    {
      "type": "processor",
      "name": "HashContent",
      "processor_type": "org.apache.nifi.processors.standard.CryptographicHashContent",
      "properties": {
        "Hash Algorithm": "SHA-256",
        "Fail When Content Empty": "false"
      },
      "auto_terminated": [],
      "bundle": {
        "group": "org.apache.nifi",
        "artifact": "nifi-standard-nar",
        "version": "2.12.0"
      }
    },
    {
      "type": "processor",
      "name": "RetryTransfer",
      "processor_type": "org.apache.nifi.processors.standard.RetryFlowFile",
      "properties": {
        "Retry Attribute": "registry.retries",
        "Maximum Retries": "${registry.retry.max}",
        "Penalize Retries": "true"
      },
      "auto_terminated": [],
      "bundle": {
        "group": "org.apache.nifi",
        "artifact": "nifi-standard-nar",
        "version": "2.12.0"
      }
    },
    {
      "type": "processor",
      "name": "Hold",
      "processor_type": "org.apache.nifi.processors.standard.LogMessage",
      "properties": {
        "Log Level": "warn",
        "Log Prefix": "Hold: ",
        "Log Message": "discarded ${registry.image} ${registry.platform} ${registry.kind} ${registry.digest}: ${registry.error}"
      },
      "auto_terminated": [
        "success"
      ],
      "bundle": {
        "group": "org.apache.nifi",
        "artifact": "nifi-standard-nar",
        "version": "2.12.0"
      }
    },
    {
      "type": "output_port",
      "name": "ToDiode"
    },
    {
      "type": "connection",
      "source": "ReceiveWebhook",
      "target": "PlanTransfer",
      "relationships": [
        "success"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 20
    },
    {
      "type": "connection",
      "source": "PlanTransfer",
      "target": "SplitJobs",
      "relationships": [
        "success"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 20
    },
    {
      "type": "connection",
      "source": "PlanTransfer",
      "target": "Hold",
      "relationships": [
        "failure"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 20
    },
    {
      "type": "connection",
      "source": "SplitJobs",
      "target": "RouteTransfer",
      "relationships": [
        "split"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 20
    },
    {
      "type": "connection",
      "source": "SplitJobs",
      "target": "Hold",
      "relationships": [
        "failure"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 20
    },
    {
      "type": "connection",
      "source": "RouteTransfer",
      "target": "FetchBlob",
      "relationships": [
        "prepared"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 10000
    },
    {
      "type": "connection",
      "source": "RouteTransfer",
      "target": "HashContent",
      "relationships": [
        "unverified"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 10000
    },
    {
      "type": "connection",
      "source": "RouteTransfer",
      "target": "ToDiode",
      "relationships": [
        "complete"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 20
    },
    {
      "type": "connection",
      "source": "RouteTransfer",
      "target": "RetryTransfer",
      "relationships": [
        "retryable"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 10000
    },
    {
      "type": "connection",
      "source": "RouteTransfer",
      "target": "Hold",
      "relationships": [
        "failure"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 20
    },
    {
      "type": "connection",
      "source": "FetchBlob",
      "target": "RouteTransfer",
      "relationships": [
        "Response"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 10000
    },
    {
      "type": "connection",
      "source": "FetchBlob",
      "target": "RouteTransfer",
      "relationships": [
        "Failure",
        "No Retry",
        "Retry"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 10000
    },
    {
      "type": "connection",
      "source": "HashContent",
      "target": "RouteTransfer",
      "relationships": [
        "success"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 10000
    },
    {
      "type": "connection",
      "source": "HashContent",
      "target": "Hold",
      "relationships": [
        "failure"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 20
    },
    {
      "type": "connection",
      "source": "RetryTransfer",
      "target": "RouteTransfer",
      "relationships": [
        "retry"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 10000
    },
    {
      "type": "connection",
      "source": "RetryTransfer",
      "target": "Hold",
      "relationships": [
        "retries_exceeded",
        "failure"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 20
    }
  ]
}
