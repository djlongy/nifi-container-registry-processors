{
  "process_group": {
    "name": "ImageTransferHighSide"
  },
  "objects": [
    {
      "type": "input_port",
      "name": "FromDiode"
    },
    {
      "type": "processor",
      "name": "RouteTransfer",
      "processor_type": "RouteRegistryTransfer",
      "properties": {
        "Transfer Side": "High",
        "Registry URL": "#{dst_url}",
        "Registry Username": "#{dst_user}",
        "Registry Password": "#{dst_password}",
        "Target Repository": "#{dst_repository}",
        "Stale After Hours": "24"
      },
      "auto_terminated": [
        "original",
        "complete"
      ],
      "bundle": {
        "group": "org.apache.nifi",
        "artifact": "python-extensions",
        "version": "1.5.1"
      }
    },
    {
      "type": "processor",
      "name": "UploadContent",
      "processor_type": "org.apache.nifi.processors.standard.InvokeHTTP",
      "properties": {
        "HTTP Method": "${registry.http.method}",
        "HTTP URL": "${registry.http.url}",
        "Request Body Enabled": "true",
        "Request Content-Type": "${registry.http.media.type}",
        "Authorization": "${registry.auth.header}",
        "Response Header Request Attributes Enabled": "true",
        "Response Header Request Attributes Prefix": "resp.",
        "Response Body Ignored": "true",
        "Response Redirects Enabled": "False",
        "Connection Timeout": "30 secs",
        "Socket Read Timeout": "10 mins",
        "Socket Write Timeout": "10 mins"
      },
      "auto_terminated": [
        "Response"
      ],
      "bundle": {
        "group": "org.apache.nifi",
        "artifact": "nifi-standard-nar",
        "version": "2.12.0"
      }
    },
    {
      "type": "processor",
      "name": "RetryTransfer",
      "processor_type": "org.apache.nifi.processors.standard.RetryFlowFile",
      "properties": {
        "Retry Attribute": "registry.retries",
        "Maximum Retries": "${registry.retry.max}",
        "Penalize Retries": "true"
      },
      "auto_terminated": [],
      "bundle": {
        "group": "org.apache.nifi",
        "artifact": "nifi-standard-nar",
        "version": "2.12.0"
      }
    },
    {
      "type": "processor",
      "name": "Hold",
      "processor_type": "org.apache.nifi.processors.standard.LogMessage",
      "properties": {
        "Log Level": "warn",
        "Log Prefix": "Hold: ",
        "Log Message": "discarded ${registry.image} ${registry.platform} ${registry.kind} ${registry.digest}: ${registry.error}"
      },
      "auto_terminated": [
        "success"
      ],
      "bundle": {
        "group": "org.apache.nifi",
        "artifact": "nifi-standard-nar",
        "version": "2.12.0"
      }
    },
    {
      "type": "processor",
      "name": "StaleImages",
      "processor_type": "org.apache.nifi.processors.standard.LogMessage",
      "properties": {
        "Log Level": "warn",
        "Log Prefix": "StaleImages: ",
        "Log Message": "discarded ${registry.image} ${registry.platform} ${registry.kind} ${registry.digest}: ${registry.error}"
      },
      "auto_terminated": [
        "success"
      ],
      "bundle": {
        "group": "org.apache.nifi",
        "artifact": "nifi-standard-nar",
        "version": "2.12.0"
      }
    },
    {
      "type": "connection",
      "name": "FromDiode",
      "source": "FromDiode",
      "target": "RouteTransfer",
      "relationships": [],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 20
    },
    {
      "type": "connection",
      "source": "RouteTransfer",
      "target": "UploadContent",
      "relationships": [
        "prepared"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 10000
    },
    {
      "type": "connection",
      "source": "RouteTransfer",
      "target": "RetryTransfer",
      "relationships": [
        "retryable",
        "waiting"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 10000
    },
    {
      "type": "connection",
      "source": "RouteTransfer",
      "target": "Hold",
      "relationships": [
        "failure",
        "unverified"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 20
    },
    {
      "type": "connection",
      "source": "UploadContent",
      "target": "RouteTransfer",
      "relationships": [
        "Original",
        "No Retry",
        "Retry",
        "Failure"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 10000
    },
    {
      "type": "connection",
      "source": "RetryTransfer",
      "target": "RouteTransfer",
      "relationships": [
        "retry"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 10000
    },
    {
      "type": "connection",
      "source": "RetryTransfer",
      "target": "Hold",
      "relationships": [
        "retries_exceeded",
        "failure"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 20
    },
    {
      "type": "connection",
      "source": "RouteTransfer",
      "target": "StaleImages",
      "relationships": [
        "stale"
      ],
      "back_pressure_data_size_threshold": "20 GB",
      "back_pressure_object_threshold": 10000
    }
  ]
}
